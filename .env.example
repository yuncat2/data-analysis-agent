# ===== 第 1 周用 DeepSeek（推荐，便宜且 function calling 稳定）=====
AGENT_API_KEY=sk-在这里填你的key
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

